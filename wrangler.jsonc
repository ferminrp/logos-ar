{
  "name": "loguitos",
  "compatibility_date": "2025-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/categorias", "/categoria/*", "/logo/*", "/guia/*", "/docs", "/banderas", "/logos/*"]
  },
  "r2_buckets": [
    {
      "binding": "LOGOS",
      "bucket_name": "loguitos-assets",
      "preview_bucket_name": "loguitos-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
