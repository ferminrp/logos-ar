---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import { LogoPageView } from '../../../views/logo-page'
import { getAllEntitySlugs } from '@/lib/entity-index'
import { GONE_LOGO_SLUGS } from '@/lib/gone-logo-slugs'
import {
  buildEntityMetaDescription,
  getEntityPageTitle,
} from '@/lib/entity-seo'
import { getEntityBySlug } from '@/lib/entity-index'
import { getEntityLogoUrl } from '@/lib/entity-logo'
import NotFoundPage from '../../../views/not-found-page'

export function getStaticPaths() {
  return getAllEntitySlugs().map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const gone = slug ? GONE_LOGO_SLUGS.has(slug) : false

if (gone) {
  Astro.response.status = 404
}

const entity = slug && !gone ? getEntityBySlug(slug) : null

let title = 'Logo no encontrado'
let description = undefined
let robots = gone ? 'noindex, nofollow' : 'index, follow'
// Self-hosted PNG logos double as the social preview; other pages keep the site default.
let ogImage: string | undefined

if (gone) {
  title = 'Logo retirado'
} else if (entity) {
  title = getEntityPageTitle(entity)
  description = buildEntityMetaDescription(entity)
  const logoUrl = getEntityLogoUrl(entity)
  if (logoUrl.startsWith('/') && logoUrl.endsWith('.png')) {
    ogImage = logoUrl
  }
} else if (slug) {
  Astro.response.status = 404
}
---

{
  gone || !entity ? (
    <BaseLayout title={title} description={description} robots={robots} canonical={`/logo/${slug}`}>
      <NotFoundPage />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={title}
      description={description}
      canonical={`/logo/${slug}`}
      twitterTitle={title}
      markdownAlternate={`/logo/${slug}.md`}
      {...(ogImage
        ? {
            ogImage,
            ogImageAlt: `Logo de ${entity.name}`,
            twitterCard: 'summary',
          }
        : {})}
    >
      <LogoPageView client:load slug={slug!} />
    </BaseLayout>
  )
}
