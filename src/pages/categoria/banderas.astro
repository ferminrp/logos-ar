---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import BanderasPage from '../../../views/banderas-page'
import { FLAGS_CATEGORY, flagsTotalCount } from '@/lib/flags-data'

const title = `Banderas de países y regiones (SVG 3:2) | Loguitos`
const description = `${flagsTotalCount} banderas de países y regiones en SVG, con URL y HTML listos para copiar.`
---

<BaseLayout title={title} description={description} canonical="/categoria/banderas">
