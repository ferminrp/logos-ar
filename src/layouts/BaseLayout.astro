---
import '@/src/styles/globals.css'
import { SiteNavbar } from '@/components/site-navbar'
import { categoryNavItems } from '@/lib/category-nav'
import { getSiteUrl } from '@/lib/site-url'
import { HOME_DESCRIPTION } from '@/lib/site-brand'

export interface Props {
  title: string
  description?: string
  canonical?: string
  robots?: string
  ogType?: string
  ogImage?: string
  ogImageAlt?: string
  twitterCard?: string
  twitterTitle?: string
  /** Path of the prerendered Markdown twin of this page (e.g. `/logo/uala.md`). */
  markdownAlternate?: string
}

const {
  title,
  description = HOME_DESCRIPTION,
  canonical,
  robots = 'index, follow',
  ogType = 'website',
  ogImage = '/og-image.jpg',
  ogImageAlt,
  twitterCard = 'summary_large_image',
  twitterTitle = title,
  markdownAlternate,
} = Astro.props

const siteUrl = getSiteUrl().replace(/\/$/, '')
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : canonical === '/'
      ? siteUrl
      : `${siteUrl}${canonical.startsWith('/') ? canonical : `/${canonical}`}`
  : `${siteUrl}${Astro.url.pathname.replace(/\/$/, '') || ''}`

const gaMeasurementId = 'G-GZLZ092Z7S'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    {markdownAlternate ? (
      <link rel="alternate" type="text/markdown" href={`${siteUrl}${markdownAlternate}`} />
    ) : null}
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Loguitos" />
  {ogImage ? (
    <>
      <meta property="og:image" content={`${siteUrl}${ogImage}`} />
      {ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
      <meta name="twitter:card" content={twitterCard} />
      <meta name="twitter:title" content={twitterTitle} />
      {description ? <meta name="twitter:description" content={description} /> : null}
      <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    </>
  ) : (
    <>
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content={twitterTitle} />
      {description ? <meta name="twitter:description" content={description} /> : null}
    </>
  )}
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Geist+Mono:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --font-dm-sans: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
        --font-newsreader: 'Newsreader', ui-serif, Georgia, serif;
        --font-geist-mono: 'Geist Mono', ui-monospace, monospace;
      }
      body {
        font-family: var(--font-dm-sans);
      }
      .font-serif {
        font-family: var(--font-newsreader);
      }
    </style>
  </head>
  <body class="font-sans antialiased">
    <SiteNavbar client:load categories={categoryNavItems} />
    <slot />
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
    <script is:inline>
      ;(function () {
        function legacyCopy(text) {
          var area = document.createElement('textarea')
          area.value = text
          area.setAttribute('readonly', '')
          area.style.position = 'fixed'
          area.style.opacity = '0'
          document.body.appendChild(area)
          area.select()
          var ok = false
          try {
            ok = document.execCommand('copy')
          } catch (_) {}
          area.remove()
          return ok
        }
        function copyText(text) {
          if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text).then(
              function () { return true },
              function () { return legacyCopy(text) },
            )
          }
          return Promise.resolve(legacyCopy(text))
        }
        var timers = new WeakMap()
        document.addEventListener('click', function (event) {
          var target = event.target instanceof Element ? event.target : null
          if (!target) return
          var copyButton = target.closest('[data-copy]')
          if (copyButton) {
            copyText(copyButton.getAttribute('data-copy') || '').then(function (ok) {
              var status = document.getElementById('copy-status')
              if (status) status.textContent = ok ? 'Copiado' : 'No se pudo copiar'
              if (!ok) return
              copyButton.setAttribute('data-copied', '')
              clearTimeout(timers.get(copyButton))
              timers.set(
                copyButton,
                setTimeout(function () {
                  copyButton.removeAttribute('data-copied')
                  if (status) status.textContent = ''
                }, 2000),
              )
            })
            return
          }
          var download = target.closest('[data-logo-download]')
          if (download && typeof window.gtag === 'function') {
            window.gtag('event', 'logo_download', {
              logo_slug: download.getAttribute('data-logo-slug'),
              logo_name: download.getAttribute('data-logo-name'),
              format: download.getAttribute('data-logo-download'),
            })
          }
        })
      })()
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || []
      window.gtag = function gtag() {
        window.dataLayer.push(arguments)
      }
      window.gtag('js', new Date())
      window.gtag('config', gaMeasurementId)
    </script>
    <script async src="https://analytics.ahrefs.com/analytics.js" data-key="wl/5EowQBWcULMyxUNjhlA"></script>
  </body>
</html>
