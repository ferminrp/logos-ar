import { writeFile } from 'node:fs/promises'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { getSiteUrl } from '../lib/site-url.ts'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const outputPath = path.resolve(__dirname, '../public/_headers')

const SITEMAP_CACHE =
  'public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800'

export function buildAssetHeadersFile(siteUrl: string): string {
  const base = siteUrl.replace(/\/$/, '')
  const link = [
    `<${base}/.well-known/api-catalog>; rel="api-catalog"`,
    `<${base}/api/logos>; rel="item"; type="application/json"`,
  ].join(', ')

  return `# Generated by scripts/generate-asset-headers.mts — do not edit by hand.
/sitemap.xml
  Cache-Control: ${SITEMAP_CACHE}

/
  Link: ${link}
`
}

async function main() {
  const siteUrl = getSiteUrl()
  const body = buildAssetHeadersFile(siteUrl)
  await writeFile(outputPath, body, 'utf8')
  console.log(`Wrote ${outputPath} (site: ${siteUrl})`)
}

main().catch((error) => {
  console.error('Failed to generate asset headers:', error)
  process.exitCode = 1
})
