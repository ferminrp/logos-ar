{
  "name": "loguitos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --experimental-strip-types scripts/run-prebuild.mts",
    "build": "astro build",
    "postbuild": "node --experimental-strip-types scripts/generate-sitemap.mts && node --experimental-strip-types scripts/generate-asset-headers.mts && node --experimental-strip-types scripts/verify-dist-asset-headers.mts && node --experimental-strip-types scripts/build-worker-entry-wrapper.mts && node --experimental-strip-types scripts/verify-worker-deploy-entry.mts && node --experimental-strip-types scripts/verify-sitemap.mts",
    "preview": "astro preview",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test \"lib/**/*.test.mts\" \"scripts/**/*.test.mts\" && pnpm test:logo-download && pnpm test:logo-download:worker && pnpm test:logos-r2:worker && pnpm test:seo-headers",
    "test:logos-r2:worker": "vitest run --config vitest.config.logos-workerd.mts",
    "sync:logos-r2": "node --experimental-strip-types scripts/sync-logos-to-r2.mts",
    "sync:isotipos-r2": "node --experimental-strip-types scripts/sync-isotipos-to-r2.mts",
    "test:logo-download": "node --experimental-strip-types --test lib/logo-download-png.test.mts lib/logo-download-api.test.mts lib/logo-download-upstream.test.mts lib/worker-runtime.test.mts",
    "test:logo-download:worker": "pnpm build && vitest run --config vitest.config.workerd.mts && node --experimental-strip-types scripts/logo-download-workerd.integration.mts",
    "test:seo-headers": "node --experimental-strip-types scripts/seo-headers-workerd.integration.mts",
    "indexnow:submit-all": "node --experimental-strip-types scripts/indexnow-submit-all.mts",
    "indexnow:ping-changed": "node --experimental-strip-types scripts/indexnow-ping-changed.mts",
    "verify:loguitos": "node --experimental-strip-types .cursor/skills/verify-loguitos/scripts/verify-loguitos.mts",
    "check:logos": "node --experimental-strip-types scripts/check-logos.mts",
    "check:catalog-hosting": "node --experimental-strip-types scripts/check-catalog-self-hosted.mts",
    "sync:sitemap-lastmod": "node --experimental-strip-types scripts/sync-sitemap-lastmod.mts",
    "generate:logo-assets": "node --experimental-strip-types scripts/generate-logo-assets.mts",
    "sync:logo-overrides": "node --experimental-strip-types scripts/sync-logo-overrides.mts",
    "test:logos": "node --experimental-strip-types --test scripts/check-logos.test.mts",
    "test:entity-seo": "node --experimental-strip-types --test lib/entity-seo.test.mts",
    "test:wcag-contrast": "node --experimental-strip-types --test lib/wcag-oklch-contrast.test.mts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@cf-wasm/photon": "^0.4.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "country-flag-icons": "^1.6.20",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "oxc-transform-react": "^0.156.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "4.1.12",
    "wrangler": "^4.166.0"
  }
}
